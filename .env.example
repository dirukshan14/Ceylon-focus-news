APP_NAME="Ceylon Focus News"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ceylon_focus_news
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Set to true when the site is served over HTTPS (production):
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="news@ceylonfocus.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Initial Super Admin (used only by DatabaseSeeder for local/dev setup) ----
# Do NOT put real production credentials here. Change immediately after first login.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@ceylonfocus.test
SUPER_ADMIN_PASSWORD=ChangeMe!12345

# ---- Third-party / analytics (optional) ----
GOOGLE_ANALYTICS_ID=
ADSENSE_PUBLISHER_ID=

VITE_APP_NAME="${APP_NAME}"

# ---- Security (see SECURITY_AUDIT_REPORT.md) ----
# Full Content-Security-Policy: report-only until you have verified the site in a browser console.
SECURITY_CSP_ENFORCE=false
# Strict-Transport-Security - ONLY on a real HTTPS production site.
SECURITY_HSTS=false
# Behind a proxy/load balancer/Cloudflare: comma separated proxy IPs (or *)
TRUSTED_PROXIES=
