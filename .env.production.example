# Production template - copy to .env on the SERVER only. Never commit .env.
APP_NAME="Ceylon Focus News"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --force
APP_DEBUG=false               # MUST be false in production
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ceylon_focus_news
DB_USERNAME=ceylon_app        # dedicated least-privilege user (SELECT/INSERT/UPDATE/DELETE [+ DDL only while migrating]) - NOT root
DB_PASSWORD=                  # long random password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true    # HTTPS only
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

SECURITY_CSP_ENFORCE=false    # switch to true after verifying no CSP reports in the browser console
SECURITY_HSTS=true            # only once HTTPS works for the whole domain
TRUSTED_PROXIES=              # set if behind a proxy / load balancer / Cloudflare

# Only used by `php artisan db:seed` on a fresh install. Must be strong (12+ chars). Remove afterwards.
SUPER_ADMIN_NAME="Site Owner"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
